<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The repository's version (kept by release-please); build.ps1 overrides it with -p:Version. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../version.txt').Trim())</Version>
    <Company>Meeting Notes</Company>
    <Product>Meeting Notes</Product>
    <Copyright>MIT License</Copyright>
    <!-- The Windows-only projects can be compiled (not run) on macOS and Linux too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
