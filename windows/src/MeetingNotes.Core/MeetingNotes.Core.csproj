<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that isn't Windows UI or audio capture: storage, transcript, prompts, providers, MCP server.
       Plain net8.0 so the unit tests run on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>MeetingNotes.Core</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MeetingNotes.Tests" />
  </ItemGroup>
</Project>
