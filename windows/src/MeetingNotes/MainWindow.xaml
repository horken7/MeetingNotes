<Window x:Class="MeetingNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meeting Notes" Width="1000" Height="680" MinWidth="760" MinHeight="480"
        Icon="Assets/app.ico" WindowStartupLocation="CenterScreen" Background="White">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Meeting Notes" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="⚙ Settings" Click="Settings_Click" Margin="0" />
                <StackPanel x:Name="RecordingPanel" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0" Visibility="Collapsed">
                    <Ellipse Width="10" Height="10" Fill="#D32F2F" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="RecordingClock" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14" Margin="0,0,10,0" />
                    <Button Content="■ Stop" Style="{StaticResource Danger}" Click="Stop_Click" />
                </StackPanel>
                <Button x:Name="StartButton" DockPanel.Dock="Right" Content="● Start meeting" Click="Start_Click" Margin="0,0,10,0" />
            </DockPanel>
        </Border>

        <!-- Banners -->
        <StackPanel x:Name="Banners" DockPanel.Dock="Top" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <DockPanel Grid.Column="0" Background="#FAFAFA">
                <Grid DockPanel.Dock="Top" Margin="10">
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="6,5" ToolTip="Search titles, notes and transcripts (Ctrl+Shift+F)" />
                    <TextBlock x:Name="SearchHint" Text="Search meetings" Foreground="#999" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <Grid>
                    <ListBox x:Name="MeetingList" BorderThickness="0" Background="Transparent" SelectionChanged="MeetingList_SelectionChanged"
                             KeyDown="MeetingList_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Show in Explorer" Click="ShowInExplorer_Click" />
                                <MenuItem x:Name="ListTrashItem" Header="Move to Recycle Bin…" Click="Trash_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock x:Name="EmptyList" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="24"
                               VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource Line}" HorizontalAlignment="Stretch" />

            <!-- Detail -->
            <Grid Grid.Column="2">
                <TextBlock x:Name="NoSelection" Text="Select a meeting" Foreground="{StaticResource Muted}" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <DockPanel x:Name="Detail" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Margin="20,18,20,10">
                        <TextBox x:Name="TitleBox" FontSize="22" FontWeight="SemiBold" BorderThickness="0" Padding="0"
                                 KeyDown="TitleBox_KeyDown" LostKeyboardFocus="TitleBox_LostFocus" ToolTip="Rename (F2)" />
                        <TextBlock x:Name="Subtitle" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Border x:Name="StatusBox" DockPanel.Dock="Top" Background="{StaticResource Box}" CornerRadius="6" Padding="12" Margin="20,0,20,12" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="StatusButton" DockPanel.Dock="Right" Click="StatusButton_Click" Margin="10,0,0,0" VerticalAlignment="Top" />
                            <ProgressBar x:Name="StatusProgress" DockPanel.Dock="Left" Width="18" Height="18" IsIndeterminate="True" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <DockPanel DockPanel.Dock="Top" Margin="20,0,20,10" LastChildFill="False">
                        <RadioButton x:Name="NotesTab" Content="Notes" GroupName="tabs" IsChecked="True" Checked="Tab_Checked" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="14" />
                        <RadioButton x:Name="TranscriptTab" Content="Transcript" GroupName="tabs" Checked="Tab_Checked" VerticalAlignment="Center" FontSize="14" />
                        <Button x:Name="MoreButton" DockPanel.Dock="Right" Content="More ▾" Click="More_Click" Margin="0">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="MoreMenu">
                                    <MenuItem x:Name="CopyNotesItem" Header="Copy notes" Click="CopyNotes_Click" />
                                    <MenuItem x:Name="CopyTranscriptItem" Header="Copy transcript" Click="CopyTranscript_Click" />
                                    <MenuItem Header="Show in Explorer" Click="ShowInExplorer_Click" />
                                    <Separator />
                                    <MenuItem x:Name="RegenerateItem" Header="Regenerate notes" Click="Regenerate_Click" />
                                    <MenuItem x:Name="RedoItem" Header="Redo transcript and notes" Click="Redo_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ArchiveItem" Header="Archive audio files…" Click="Archive_Click" />
                                    <MenuItem x:Name="TrashItem" Header="Move to Recycle Bin…" Click="Trash_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="CopyButton" DockPanel.Dock="Right" Click="Copy_Click" ToolTip="Copy to the clipboard (Ctrl+Shift+C)" />
                    </DockPanel>

                    <DockPanel x:Name="FindBar" DockPanel.Dock="Top" Margin="20,0,20,10" Visibility="Collapsed" LastChildFill="False">
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="FindBox" Width="260" TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown" />
                        <TextBlock x:Name="FindCount" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0" />
                        <Button Content="▲" Click="FindPrev_Click" ToolTip="Previous match (Shift+F3)" />
                        <Button Content="▼" Click="FindNext_Click" ToolTip="Next match (F3 or Enter)" />
                        <Button DockPanel.Dock="Right" Content="Done" Click="FindDone_Click" Margin="0" />
                    </DockPanel>

                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                        <Grid>
                            <FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" />
                            <TextBlock x:Name="Placeholder" Foreground="{StaticResource Muted}" Margin="20" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
