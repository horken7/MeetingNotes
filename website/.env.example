# Copy to .env.local for local development, or add these in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# Stripe secret key. Use the TEST key (sk_test_...) until you are ready to sell.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...), see STRIPE_SETUP.md.
STRIPE_WEBHOOK_SECRET=
# "true" to let Stripe Tax calculate EU VAT at checkout (turn on Stripe Tax in the Dashboard first).
STRIPE_AUTOMATIC_TAX=false

# Optional: use Prices you created in the Stripe Dashboard instead of the prices in src/config/pricing.ts.
STRIPE_PRICE_MAC=
STRIPE_PRICE_WINDOWS=
STRIPE_PRICE_ANDROID=
STRIPE_PRICE_BUNDLE=

# Public URL of the site, used for Stripe redirects and SEO. Defaults to the Vercel URL.
NEXT_PUBLIC_SITE_URL=
